.git
.gitignore
.github

# Secrets and local configuration
.env
.env.backup
.env.*.local
ca.pem
*.pem

# Local dependency folders
vendor
node_modules
**/node_modules

# Local build output (rebuilt inside Docker)
public/build
public/admin
public/storage
public/hot
backend/dist

# Local caches / logs / session files
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
storage/*.key

# Runtime uploads. These are not tracked by Git, so building an image from a
# working tree that has test uploads used to bake those old files into the
# production image and make them reappear after a deploy.
storage/app/public/images
storage/app/public/banners
storage/app/public/payment-proofs
storage/app/public/logos

# Local database and tooling
database/database.sqlite
.phpunit.result.cache
phpunit.xml
php.ini
docs
docker-compose.yml
Dockerfile
Dockerfile.dev
